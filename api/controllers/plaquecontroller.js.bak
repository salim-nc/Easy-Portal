    });

    res.setHeader('Content-Type', 'text/csv');
    res.setHeader('Content-Disposition', 'attachment; filename=plaques_non_autorisees.csv');
    res.send(csv);
  } catch (error) {
    console.error('Erreur lors de l\'export CSV:', error);
    res.status(500).json({
      success: false,
