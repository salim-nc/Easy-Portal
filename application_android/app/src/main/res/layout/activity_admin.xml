<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="30dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESPACE ADMINISTRATEUR"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#004aa2"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gérez les accès et la surveillance"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Surveillance en direct"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="600dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#000000"
            android:layout_marginBottom="32dp">

            <WebView
                android:id="@+id/webviewCamera"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#B0FFFFFF"
                android:layout_gravity="center"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actions rapides"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnOpenGateAdmin"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="OUVRIR LE PORTAIL"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#004aa2"
                android:textColor="@android:color/white"
                android:drawableStart="@android:drawable/ic_menu_upload"
                android:drawableTint="#FFFFFF"
                android:paddingStart="20dp"
                android:drawablePadding="10dp"
                android:layout_marginBottom="20dp"
                app:cornerRadius="12dp"/>

            <Button
                android:id="@+id/btnLogoutAdmin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Se déconnecter"
                android:textSize="16sp"
                android:backgroundTint="#EF4444"
                android:textColor="@android:color/white"
                android:drawableStart="@android:drawable/ic_lock_power_off"
                android:drawableTint="#FFFFFF"
                android:paddingStart="20dp"
                android:drawablePadding="10dp"
                app:cornerRadius="12dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>